---
// 병아리 — 순수 CSS/DOM 도형. size로 크기 조절.
interface Props {
  size?: number;
  shadow?: boolean;
}
const { size = 56, shadow = true } = Astro.props;
// 핸드오프 비율을 기준으로 눈/부리 위치를 size에 비례시킵니다.
const h = Math.round(size * 0.93);
const eye = Math.max(5, Math.round(size * 0.11));
const eyeTop = Math.round(size * 0.38);
const eyeSide = Math.round(size * 0.28);
const beak = Math.max(6, Math.round(size * 0.13));
const beakTop = Math.round(size * 0.5);
---

<span
  class="chick"
  style={`width:${size}px;height:${h}px;${shadow ? 'box-shadow:0 6px 12px rgba(0,0,0,.14)' : ''}`}
>
  <i class="eye" style={`top:${eyeTop}px;left:${eyeSide}px;width:${eye}px;height:${eye}px;border-radius:50%`}></i>
  <i class="eye" style={`top:${eyeTop}px;right:${eyeSide}px;width:${eye}px;height:${eye}px;border-radius:50%`}></i>
  <i
    class="beak"
    style={`top:${beakTop}px;left:50%;transform:translateX(-50%) rotate(45deg);width:${beak}px;height:${beak}px`}
  ></i>
</span>

<style>
  .chick {
    position: relative;
    display: inline-block;
    border-radius: 50% 50% 48% 48%;
    background: radial-gradient(circle at 50% 32%, #f8e25c, #f2ce3e);
    flex: none;
  }
  .chick i {
    position: absolute;
  }
  .eye {
    background: #2b2b2b;
  }
  .beak {
    background: #ee7e5a;
  }
</style>
