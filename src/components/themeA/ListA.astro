---
import { fmtFull, categoryColor, type Notice } from '../../lib/notices';
interface Props {
  notices: Notice[];
}
const { notices } = Astro.props;
---

<div class="list-a view">
  <div class="back-bar"><a class="back" href="/">← 메인으로</a></div>
  <div class="body-pad">
    <h1 class="title">공지사항</h1>
    <div class="subtitle">All notices</div>
    <div class="rows">
      {
        notices.map((n) => (
          <a class="row" href={`/notices/${n.id}/`}>
            <div class="row-main">
              <div class="row-meta">
                <span class="cat" style={`background:${categoryColor(n.data.category)}`}>{n.data.category}</span>
                <span class="date">{fmtFull(n.data.date)}</span>
              </div>
              <div class="row-title">{n.data.title}</div>
            </div>
            <span class="chev">›</span>
          </a>
        ))
      }
    </div>
  </div>
</div>

<style>
  .list-a {
    background: var(--cream-a);
  }
  .back-bar {
    padding: 20px 28px 0;
  }
  .back {
    font-family: 'Jua', sans-serif;
    font-size: 14px;
    color: var(--ink-soft2);
  }
  .body-pad {
    padding: 18px 28px 44px;
  }
  .title {
    font-family: 'Jua', sans-serif;
    font-weight: 400;
    font-size: 28px;
    color: var(--ink);
    margin: 0;
  }
  .subtitle {
    font-family: 'Fredoka', sans-serif;
    font-size: 13px;
    color: var(--muted);
    margin-top: 4px;
  }
  .rows {
    margin-top: 18px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .row {
    background: #fff;
    border-radius: 16px;
    padding: 15px 17px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }
  .row-meta {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .cat {
    font-family: 'Jua', sans-serif;
    font-size: 11px;
    color: #fff;
    background: var(--coral);
    padding: 3px 10px;
    border-radius: 999px;
    white-space: nowrap;
  }
  .date {
    font-family: 'Fredoka', sans-serif;
    font-size: 12px;
    color: var(--muted);
  }
  .row-title {
    font-size: 15px;
    color: var(--ink);
    margin-top: 7px;
  }
  .chev {
    color: #cdbfa3;
  }
</style>
