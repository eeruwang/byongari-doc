---
import { fmtShort, fmtKorean, type Notice } from '../../lib/notices';
interface Props {
  notice: Notice;
}
const { notice } = Astro.props;
const d = notice.data;
const label = d.categoryLabel ?? d.category;
---

<div class="detail-b view">
  <div class="back-bar"><a class="back" href="/notices/">← Notices</a></div>
  <div class="body-pad">
    <div class="eyebrow">{label} · {fmtShort(d.date)}</div>
    <h1 class="title">{d.title}</h1>
    <div class="meta">
      <span class="dot"></span>
      <span>{d.author} · {fmtKorean(d.date)}</span>
    </div>
    <div class="rule"></div>
    {d.summary && <p class="summary">{d.summary}</p>}
    {
      d.info.length > 0 && (
        <div class="info">
          {d.info.map((row) => (
            <div class="info-row">
              <span class="info-label">{row.label}</span>
              <span class="info-value">{row.value}</span>
            </div>
          ))}
        </div>
      )
    }
    <div class="content">
      <slot />
    </div>
    {
      d.tags.length > 0 && (
        <div class="tags">
          {d.tags.map((t) => (
            <span class="tag">#{t}</span>
          ))}
        </div>
      )
    }
  </div>
</div>

<style>
  .detail-b {
    background: var(--cream-b);
  }
  .back-bar {
    padding: 22px 34px;
    border-bottom: 1px solid var(--hairline);
  }
  .back {
    font-size: 14px;
    color: var(--teal);
  }
  .body-pad {
    padding: 46px 34px;
  }
  .eyebrow {
    font-family: 'Fredoka', sans-serif;
    font-size: 12px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--teal);
  }
  .title {
    font-family: 'Fredoka', sans-serif;
    font-weight: 500;
    font-size: 30px;
    line-height: 1.35;
    color: var(--ink2);
    margin: 14px 0 0;
  }
  .meta {
    display: flex;
    align-items: center;
    gap: 9px;
    margin-top: 16px;
  }
  .dot {
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: var(--yellow);
  }
  .meta span:last-child {
    font-size: 14px;
    color: var(--ink-soft3);
  }
  .rule {
    height: 1px;
    background: var(--hairline);
    margin: 24px 0;
  }
  .summary {
    font-size: 15px;
    line-height: 1.95;
    color: #5f685d;
    margin: 0;
  }
  .info {
    margin-top: 24px;
  }
  .info-row {
    display: flex;
    gap: 16px;
    padding: 13px 0;
    border-bottom: 1px solid var(--hairline);
  }
  .info-row:last-child {
    border-bottom: none;
  }
  .info-label {
    font-family: 'Fredoka', sans-serif;
    font-size: 12px;
    letter-spacing: 0.08em;
    color: var(--teal);
    width: 74px;
    flex: none;
  }
  .info-value {
    font-size: 15px;
    color: var(--ink2);
  }
  .content {
    font-size: 15px;
    line-height: 1.95;
    color: #5f685d;
    margin-top: 24px;
  }
  .content :global(p) {
    margin: 0 0 1em;
  }
  .content :global(p:last-child) {
    margin-bottom: 0;
  }
  .content :global(a) {
    color: var(--teal);
    text-decoration: underline;
  }
  .tags {
    display: flex;
    gap: 16px;
    margin-top: 24px;
    flex-wrap: wrap;
  }
  .tag {
    font-size: 14px;
    color: var(--muted2);
  }
</style>
