---
import { fmtShort, type Notice } from '../../lib/notices';
interface Props {
  notices: Notice[];
}
const { notices } = Astro.props;
---

<div class="list-b view">
  <div class="back-bar"><a class="back" href="/">← Home</a></div>
  <div class="body-pad">
    <h1 class="title">공지사항</h1>
    <div class="subtitle">All notices</div>
    <div class="rows">
      {
        notices.map((n) => (
          <a class="row" href={`/notices/${n.id}/`}>
            <div class="row-left">
              <span class="date">{fmtShort(n.data.date)}</span>
              <span class="row-title">{n.data.title}</span>
            </div>
            <span class="cat">{n.data.category}</span>
          </a>
        ))
      }
    </div>
  </div>
</div>

<style>
  .list-b {
    background: var(--cream-b);
  }
  .back-bar {
    padding: 22px 34px;
    border-bottom: 1px solid var(--hairline);
  }
  .back {
    font-size: 14px;
    color: var(--teal);
  }
  .body-pad {
    padding: 40px 34px;
  }
  .title {
    font-family: 'Fredoka', sans-serif;
    font-weight: 500;
    font-size: 30px;
    color: var(--ink2);
    margin: 0;
  }
  .subtitle {
    font-family: 'Fredoka', sans-serif;
    font-size: 12px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--teal);
    margin-top: 6px;
  }
  .rows {
    margin-top: 22px;
  }
  .row {
    display: flex;
    gap: 16px;
    align-items: center;
    justify-content: space-between;
    padding: 16px 0;
    border-bottom: 1px solid var(--hairline);
  }
  .row-left {
    display: flex;
    gap: 16px;
    align-items: baseline;
    min-width: 0;
  }
  .date {
    font-family: 'Fredoka', sans-serif;
    font-size: 12px;
    color: var(--muted2);
    width: 80px;
    flex: none;
  }
  .row-title {
    font-size: 15px;
    color: var(--ink2);
  }
  .cat {
    font-family: 'Fredoka', sans-serif;
    font-size: 11px;
    color: var(--teal);
    white-space: nowrap;
  }
</style>
