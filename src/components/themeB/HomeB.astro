---
import { site } from '../../data/site';
import { fmtShort, type Notice } from '../../lib/notices';
import Avatar from '../Avatar.astro';

interface Props {
  recent: Notice[];
}
const { recent } = Astro.props;
const staffColors = ['#F4C64A', '#9BD3CB', '#F3B0A0'];
---

<div class="home-b">
  {/* hero */}
  <section class="hero">
    <div class="eyebrow">{site.hero.b.eyebrow}</div>
    <h1 class="title" set:html={site.hero.b.title} />
    <p class="desc">{site.hero.b.desc}</p>
    <p class="sub">{site.hero.b.sub}</p>
    <div class="cta">
      <a class="btn-dark" href={site.links.signup}>가입 신청하기</a>
      <a class="btn-yellow" href={site.links.discord}>디스코드</a>
    </div>
  </section>

  <div class="hr"></div>

  {/* about */}
  <section class="sec">
    <div class="sec-head"><span class="num">01</span><span class="sec-title">서버 소개</span><span class="sec-en">About</span></div>
    <p class="body">{site.about.bodyB}</p>
    <div class="pillars">
      {
        site.concepts.map((c, i) => [
          i > 0 && <div class="vline" />,
          <div>
            <div class="pillar-en">{c.en.toUpperCase()}</div>
            <div class="pillar-ko">{c.ko}</div>
          </div>,
        ])
      }
    </div>
  </section>

  <div class="hr"></div>

  {/* notices */}
  <section class="sec">
    <div class="sec-head"><span class="num">02</span><span class="sec-title">공지사항</span><span class="sec-en">Notices</span></div>
    <div class="notice-list">
      {
        recent.map((n) => (
          <a class="notice-row" href={`/notices/${n.id}/`}>
            <span class="nr-left">
              <span class="nr-date">{fmtShort(n.data.date)}</span>
              <span class="nr-title">{n.data.title}</span>
            </span>
            <span class="arrow">→</span>
          </a>
        ))
      }
    </div>
    <a class="text-link" href="/notices/">전체 공지사항 보기 →</a>
  </section>

  <div class="hr"></div>

  {/* join */}
  <section class="sec">
    <div class="sec-head"><span class="num">03</span><span class="sec-title">가입 방법</span><span class="sec-en">How to join</span></div>
    <div class="steps">
      {
        site.join.map((s, i) => (
          <div class="step">
            <div class="step-num">{i + 1}</div>
            <div>
              <div class="step-title">{s.title}</div>
              <div class="step-desc">{s.desc}</div>
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <div class="hr"></div>

  {/* rules */}
  <section class="sec">
    <div class="sec-head"><span class="num">04</span><span class="sec-title">서버 규칙</span><span class="sec-en">Rules</span></div>
    <div class="rules">
      {
        site.rules.map((r) => (
          <div class="rule"><span class="dot">·</span><span>{r}</span></div>
        ))
      }
    </div>
  </section>

  <div class="hr"></div>

  {/* staff */}
  <section class="sec">
    <div class="sec-head"><span class="num">05</span><span class="sec-title">운영진</span><span class="sec-en">Staff</span></div>
    <div class="staff">
      {
        site.staff.map((m, i) => (
          <div class="staff-col">
            <Avatar initial={m.initial} bg={staffColors[i]} size={50} avatar={m.avatar} alt={m.handle} />
            <div class="staff-handle">{m.handle}</div>
            <div class="staff-role">{m.roleShort}</div>
          </div>
        ))
      }
    </div>
  </section>

  <div class="hr"></div>

  {/* support */}
  <section class="sec">
    <div class="sec-head"><span class="num">06</span><span class="sec-title">후원 안내</span><span class="sec-en">Support</span></div>
    <div class="support">
      <div class="support-text">매달 약 <b>{site.support.amount}</b> 으로<br />운영되고 있어요.</div>
      <a class="btn-dark sm" href={site.support.url}>후원하기</a>
    </div>
  </section>

  <div class="hr"></div>

  {/* faq */}
  <section class="sec">
    <div class="sec-head"><span class="num">07</span><span class="sec-title">자주 묻는 질문</span></div>
    <div class="faq">
      {
        site.faq.map((f) => (
          <div class="faq-item">
            <div class="faq-q">{f.q}</div>
            <div class="faq-a">{f.a}</div>
          </div>
        ))
      }
    </div>
  </section>

  {/* footer */}
  <footer class="foot">
    <div class="foot-links">
      <a class="fl-accent" href={site.links.signup}>가입 신청</a>
      <a href={site.links.discord}>디스코드</a>
      <a href={site.links.status}>서버 상태</a>
    </div>
    <div class="copyright">{site.name} · {site.nameEn} — a small Misskey server</div>
  </footer>
</div>

<style>
  .home-b {
    background: var(--cream-b);
  }
  .hr {
    height: 1px;
    background: var(--hairline);
    margin: 0 34px;
  }
  .sec {
    padding: 44px 34px;
  }
  .sec-head {
    display: flex;
    align-items: baseline;
    gap: 10px;
  }
  .num {
    font-family: 'Fredoka', sans-serif;
    font-size: 13px;
    color: var(--teal);
  }
  .sec-title {
    font-family: 'Fredoka', sans-serif;
    font-weight: 500;
    font-size: 22px;
    color: var(--ink2);
  }
  .sec-en {
    font-size: 13px;
    color: #b0b4a6;
  }
  .body {
    font-size: 15px;
    line-height: 1.9;
    color: #5f685d;
    margin: 16px 0 0;
  }

  /* hero */
  .hero {
    padding: 60px 34px 50px;
  }
  .eyebrow {
    font-family: 'Fredoka', sans-serif;
    font-size: 12px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--teal);
  }
  .title {
    font-family: 'Fredoka', sans-serif;
    font-weight: 500;
    font-size: 40px;
    line-height: 1.25;
    color: var(--ink2);
    margin: 16px 0 0;
  }
  .title :global(.accent) {
    color: var(--teal);
  }
  .desc {
    font-size: 15px;
    line-height: 1.8;
    color: #6e776c;
    margin: 18px 0 0;
  }
  .sub {
    font-family: 'Fredoka', sans-serif;
    font-size: 13px;
    color: var(--muted2);
    margin: 10px 0 0;
  }
  .cta {
    display: flex;
    gap: 12px;
    margin-top: 28px;
    flex-wrap: wrap;
  }
  .btn-dark {
    font-size: 15px;
    color: #fff;
    background: var(--ink2);
    padding: 13px 24px;
    border-radius: 8px;
  }
  .btn-dark.sm {
    font-size: 14px;
    padding: 11px 20px;
    white-space: nowrap;
  }
  .btn-yellow {
    font-size: 15px;
    color: var(--ink2);
    background: var(--yellow);
    padding: 13px 24px;
    border-radius: 8px;
  }

  /* pillars */
  .pillars {
    display: flex;
    gap: 20px;
    margin-top: 22px;
  }
  .vline {
    width: 1px;
    background: #e7e3d5;
  }
  .pillar-en {
    font-family: 'Fredoka', sans-serif;
    font-size: 11px;
    letter-spacing: 0.1em;
    color: var(--teal);
  }
  .pillar-ko {
    font-size: 14px;
    color: var(--ink2);
    margin-top: 3px;
  }

  /* notices */
  .notice-list {
    margin-top: 18px;
  }
  .notice-row {
    display: flex;
    gap: 14px;
    align-items: center;
    justify-content: space-between;
    padding: 15px 0;
    border-bottom: 1px solid var(--hairline);
  }
  .nr-left {
    display: flex;
    gap: 14px;
    align-items: baseline;
    min-width: 0;
  }
  .nr-date {
    font-family: 'Fredoka', sans-serif;
    font-size: 13px;
    color: var(--muted2);
    width: 46px;
    flex: none;
  }
  .nr-title {
    font-size: 15px;
    color: var(--ink2);
  }
  .arrow {
    color: #cdcec3;
  }
  .text-link {
    display: inline-block;
    margin-top: 16px;
    font-size: 14px;
    color: var(--teal);
    border-bottom: 1px solid #b6e0da;
  }

  /* steps */
  .steps {
    margin-top: 20px;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .step {
    display: flex;
    gap: 16px;
  }
  .step-num {
    font-family: 'Fredoka', sans-serif;
    font-size: 22px;
    color: #dcd6c4;
    flex: none;
    width: 26px;
  }
  .step-title {
    font-size: 15px;
    color: var(--ink2);
  }
  .step-desc {
    font-size: 14px;
    color: var(--ink-soft3);
    margin-top: 2px;
  }

  /* rules */
  .rules {
    margin-top: 16px;
    display: flex;
    flex-direction: column;
    gap: 13px;
  }
  .rule {
    display: flex;
    gap: 10px;
    font-size: 15px;
    color: #5f685d;
  }
  .dot {
    color: var(--teal);
  }

  /* staff */
  .staff {
    margin-top: 18px;
    display: flex;
    gap: 12px;
  }
  .staff-col {
    flex: 1;
    text-align: center;
  }
  .avatar {
    width: 50px;
    height: 50px;
    border-radius: 50%;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: 'Fredoka', sans-serif;
    color: var(--ink2);
  }
  .staff-handle {
    font-size: 14px;
    color: var(--ink2);
    margin-top: 8px;
  }
  .staff-role {
    font-size: 12px;
    color: var(--muted2);
    margin-top: 2px;
  }

  /* support */
  .support {
    margin-top: 16px;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
  }
  .support-text {
    font-size: 15px;
    line-height: 1.7;
    color: #5f685d;
  }
  .support-text b {
    color: var(--ink2);
  }

  /* faq */
  .faq {
    margin-top: 18px;
    display: flex;
    flex-direction: column;
    gap: 18px;
  }
  .faq-q {
    font-size: 15px;
    color: var(--ink2);
  }
  .faq-a {
    font-size: 14px;
    color: var(--ink-soft3);
    margin-top: 4px;
  }

  /* footer */
  .foot {
    padding: 34px;
    background: var(--ink2);
  }
  .foot-links {
    display: flex;
    gap: 20px;
    flex-wrap: wrap;
  }
  .foot-links a {
    font-size: 14px;
    color: #cfd3c8;
  }
  .foot-links a.fl-accent {
    color: var(--yellow);
  }
  .copyright {
    font-family: 'Fredoka', sans-serif;
    font-size: 12px;
    color: #7e857a;
    margin-top: 18px;
  }
</style>
